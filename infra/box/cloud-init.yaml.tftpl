#cloud-config
# First boot of the prod box (Ubuntu 24.04 on Lightsail). Rendered by Terraform with
# templatefile(): $${deploy_sh} is infra/box/deploy.sh (literal $ escaped as $$ here). Nothing secret is in here; secrets
# arrive later over SSH via `make prod-secrets` into /etc/ghost-ledger (mode 0700).

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - unattended-upgrades

# Headroom for Postgres + the poller + Debezium's JVM (week 2) on 2 GB of RAM
swap:
  filename: /swapfile
  size: 2G

write_files:
  - path: /usr/local/bin/ghost-ledger-deploy
    permissions: "0755"
    content: |
      ${indent(6, deploy_sh)}

  - path: /etc/docker/daemon.json
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "10m", "max-file": "5"}}

  - path: /etc/systemd/system/ghost-ledger-deploy.service
    content: |
      [Unit]
      Description=Pull and deploy the ghost-ledger image if it changed
      After=docker.service network-online.target
      Wants=network-online.target
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/ghost-ledger-deploy

  - path: /etc/systemd/system/ghost-ledger-deploy.timer
    content: |
      [Unit]
      Description=Deploy ghost-ledger every 5 minutes

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=5min
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /etc/apt/apt.conf.d/52ghost-ledger-upgrades
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "09:30";

runcmd:
  # Docker Engine + Compose plugin from Docker's apt repo (compose.prod.yml uses !override,
  # which needs Compose >= 2.24.4; Ubuntu's own package can lag behind)
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - >-
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc]
    https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable"
    > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - usermod -aG docker ubuntu
  - install -d -m 0700 -o root -g root /etc/ghost-ledger
  - install -d -m 0755 /opt/ghost-ledger
  - systemctl daemon-reload
  - systemctl enable --now ghost-ledger-deploy.timer
