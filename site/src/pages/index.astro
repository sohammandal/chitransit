---
import Base from "../layouts/Base.astro";
import App from "../components/App.svelte";
import Shell from "../components/Shell.astro";
const description = "See every Chicago bus live: where riders are waiting far too long, where buses arrive bunched together, and how each route ran yesterday. Unofficial.";
---
<Base title="Chicago buses, live | chitransit.fyi" {description}>
  <div class="about-page">
    <h1>Chicago buses, live</h1>
    <p>{description}</p>
  </div>
  <Shell />
  <App client:only="svelte" />
  <noscript>The live map needs JavaScript</noscript>
</Base>
