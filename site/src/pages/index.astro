---
import Base from "../layouts/Base.astro";
import App from "../components/App.svelte";
---
<Base
  title="Chicago buses, live | chitransit.fyi"
  description="Every CTA bus on one map, updated every 30 seconds, with the gap to the bus ahead. Unofficial."
>
  <!-- Static shell: paints before any JavaScript; the live card covers it once the map mounts. -->
  <div class="shell" aria-hidden="true">
    <span class="brand">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="6" /><circle cx="9" cy="3" r="2.8" /><circle cx="15" cy="21" r="2.8" /></svg>
      <span><span class="chi">chi</span>transit<b>.fyi</b></span>
    </span>
    <span class="wait">Connecting to the live feed…</span>
  </div>
  <App client:only="svelte" />
  <noscript>The live map needs JavaScript.</noscript>
</Base>

<style>
  .shell {
    position: fixed; z-index: 1;
    top: calc(12px + var(--safe-top)); left: calc(12px + var(--safe-left));
    width: min(320px, calc(100vw - 24px - var(--safe-left) - var(--safe-right)));
    background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow);
    padding: 12px 14px; display: grid; gap: 8px;
  }
  .brand { display: flex; align-items: center; gap: 8px; font-size: 19px; font-weight: 800; letter-spacing: -0.01em; }
  .brand b { font-weight: 400; color: var(--fog); }
  .chi { color: var(--flag-blue); }
  svg { width: 26px; height: 26px; overflow: visible; }
  rect { fill: none; stroke: var(--asphalt); stroke-width: 2.5; }
  circle { fill: var(--flag-blue); stroke: var(--surface); stroke-width: 1.5; }
  .wait { font-size: 15px; color: var(--fog); }
  @media (max-width: 640px) {
    .shell { left: calc(8px + var(--safe-left)); right: calc(8px + var(--safe-right)); width: auto; top: calc(8px + var(--safe-top)); padding: 10px 12px; }
  }
</style>
