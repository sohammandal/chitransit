# Copy to .env for local overrides. Real API keys should stay in ~/.secrets
# (sourced by ~/.zshrc); environment variables always win over .env.

# CTA Bus Tracker v3 key (already exported from ~/.secrets on this machine)
CTA_BUS_TRACKER_API_KEY=
# CTA Train Tracker key (requested 2026-09-25, pending)
CTA_TRAIN_TRACKER_API_KEY=

# Local Postgres from docker-compose.yml (port 5433 to avoid clashing with any local Postgres)
DATABASE_URL=postgresql://ghost:ghost@localhost:5433/ghost_ledger

# Poll cadence — matches what was stated on the CTA key application (~30 s)
POLL_INTERVAL_SECONDS=30
