# Python
__pycache__/
*.py[codz]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.sqlfluff_cache/

# Secrets — keys live in ~/.secrets or .env, never in git
.env
.env.*
!.env.example
!.env.dev

# Local-only docs (briefs, research, Claude Code context)
docs/
CLAUDE.md

# Local data and engines
data/*
!data/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet

# dbt
target/
dbt_packages/
logs/

# Dagster
.dagster/
tmp*/

# OS / editors
.DS_Store
.vscode/
.idea/

# Terraform (state lives in S3 or, for bootstrap, only on the laptop)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/terraform/**/terraform.tfvars
infra/terraform/**/backend.hcl

# dbt (per-machine id, logs)
transform/.user.yml
transform/logs/

# Site (Astro): dependencies, build output, generated types; data is published, never committed
node_modules/
site/dist/
site/.astro/
site/public/data/
site/public/live/

# Browser test output (site/e2e)
site/playwright-report/
site/test-results/
.coverage
