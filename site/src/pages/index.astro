---
import Base from "../layouts/Base.astro";
import App from "../components/App.svelte";
import Shell from "../components/Shell.astro";
const description = "Every Chicago bus and 'L' train, live: where riders wait far too long, where buses arrive bunched, and how each route ran yesterday. Unofficial.";
---
<Base title="Chicago buses and trains, live | chitransit.fyi" {description}>
  <div class="about-page">
    <h1>Chicago buses and trains, live</h1>
    <p>{description}</p>
  </div>
  <Shell />
  <App client:only="svelte" />
  <noscript>The live map needs JavaScript</noscript>
</Base>
