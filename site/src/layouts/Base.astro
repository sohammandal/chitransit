---
import "@fontsource-variable/overpass";
import overpassLatin from "@fontsource-variable/overpass/files/overpass-latin-wght-normal.woff2?url";
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  /** A link preview's picture and kind: the app's own by default; an article brings its own. */
  image?: { url: string; width: number; height: number; alt: string };
  type?: "website" | "article";
}
const APP_IMAGE = {
  url: "https://chitransit.fyi/og.jpg",
  width: 2400,
  height: 1260,
  alt: "The 9 Ashland route view: buses together in amber and long waits in red, beside the live map",
};
const { title, description, image = APP_IMAGE, type = "website" } = Astro.props;
// One address per page for search engines and link previews (www serves the same site).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// What the site is, for search engines (schema.org): on the home page only.
const home = Astro.url.pathname === "/";
const site = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "chitransit",
  url: "https://chitransit.fyi/",
  description,
  applicationCategory: "TravelApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="chitransit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2f4f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12181d" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="chitransit" />
    <!-- Home-screen app: the map runs up behind the status bar (the panels keep clear of it with
         --safe-top); a scrim keeps the status bar's white text readable on the light map. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <!-- Installable: Chrome's install button, Android's "Install app" (public/manifest.json) -->
    <link rel="manifest" href="/manifest.json" />
    <!-- Start the slow handshakes early: the one font face, the basemap host. -->
    <link rel="preload" href={overpassLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    <!-- Which commit is live: the deploy waits for this before testing prod. -->
    <meta name="build" content={import.meta.env.PUBLIC_BUILD ?? "local"} />
    <title>{title}</title>
    {home && <script type="application/ld+json" is:inline set:html={site} />}
  </head>
  <body>
    <slot />
    <div class="status-scrim" aria-hidden="true"></div>
    <script>
      // Page views on every page, reports included (lib/count.ts: cookieless, our own beacon, the
      // real site only). The live map counts its own moves too: the counter skips the page it has
      // just counted, so its first view counts once
      import { countView } from "../lib/count";
      countView();
    </script>
  </body>
</html>
