# Settings reference. Copy to .env for local overrides (gitignored).
# Dev precedence: real environment variables > .env > .env.dev (committed defaults).
# Prod reads real environment variables only (the env file on the box), never these files.
# Real API keys stay in ~/.secrets (sourced by ~/.zshrc).

# dev (laptop, default) or prod (Lightsail box)
GHOST_LEDGER_ENV=dev

# CTA Bus Tracker v3 key (exported from ~/.secrets on this machine)
CTA_BUS_TRACKER_API_KEY=

# CTA Train Tracker key (requested 2026-09-25, pending)
CTA_TRAIN_TRACKER_API_KEY=

# Required in prod. Dev defaults to the local Docker Postgres on port 5433.
DATABASE_URL=postgresql://ghost:ghost@localhost:5433/ghost_ledger

# Poll cadence. Matches what was stated on the CTA key application (~30 s).
POLL_INTERVAL_SECONDS=30

# Comma-separated routes to poll; empty = all. Dev and prod share one key quota.
POLL_ROUTES=

# Minutes a bus may be missing from the feed before its trip assignment is deleted
ASSIGNMENT_GRACE_MINUTES=10
