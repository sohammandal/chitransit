# Dev defaults (committed, no secrets). Active when GHOST_LEDGER_ENV=dev, the default.
# Precedence: real environment variables > .env (local, gitignored) > this file.
# Prod never reads this file or .env.
# API keys come from ~/.secrets, never from here.

DATABASE_URL=postgresql://ghost:ghost@localhost:5433/ghost_ledger
POLL_INTERVAL_SECONDS=30
# Empty = every route. Once prod polls 24/7, set POLL_ROUTES=79,9 here:
# dev and prod share one API key and its 100k calls/day quota.
POLL_ROUTES=
ASSIGNMENT_GRACE_MINUTES=10
